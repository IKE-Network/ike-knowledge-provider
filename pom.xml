<?xml version="1.0" encoding="UTF-8"?>
<!--
  IKE Network — Knowledge Provider
  ════════════════════════════════

  The chronology-store implementation of the IKE knowledge-pipeline SPI
  (network.ike.tooling:ike-knowledge-spi; IKE-Network/ike-issues#850, #856).
  This artifact is the stable IKE-named provider consumers depend on —
  directly or via ike-parent's default wiring — while the engine libraries
  underneath keep names that are free to migrate. It carries SPI adaptation
  and orchestration only; engine-generic capabilities stay in the engine.

  Incubates in the ike-komet-wsr꞉chronology-builder workspace while it
  depends on the sibling-only engine snapshot; graduates to a top-level
  foundation sibling at branch merge.
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>network.ike.platform</groupId>
        <artifactId>ike-parent</artifactId>
        <version>196</version>
        <relativePath/>
    </parent>

    <groupId>network.ike.knowledge</groupId>
    <artifactId>ike-knowledge-provider</artifactId>
    <version>7-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>IKE Knowledge Provider</name>
    <description>
        Chronology-store implementation of the IKE knowledge-pipeline SPI:
        ServiceLoader providers for export, assembly, bindings, and verification,
        composing the engine's capability libraries behind the stable IKE contract.
    </description>
    <url>https://ike.network/ike-knowledge-provider/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <scm>
        <connection>scm:git:https://github.com/IKE-Network/ike-knowledge-provider.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/ike-knowledge-provider.git</developerConnection>
        <url>https://github.com/IKE-Network/ike-knowledge-provider</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <repository>
            <id>ike-staging</id>
            <url>${deploy.staging.url}</url>
        </repository>
        <snapshotRepository>
            <id>ike-snapshots</id>
            <url>${deploy.snapshot.url}</url>
        </snapshotRepository>
        <site>
            <id>ike-site</id>
            <url>https://ike.network/ike-knowledge-provider/</url>
        </site>
    </distributionManagement>

    <!-- Snapshots of the IKE starter set resolve through here on a machine whose settings
         enable no snapshot repository, such as the test agent: a mirror's policy is the
         merge of the repositories a build declares (IkeKometWs_ReactorTest #157). The same
         block as rocks-kb, tinkar-service and komet carry; ike-parent is its durable home. -->
    <repositories>
        <repository>
            <id>tinkar-nexus</id>
            <url>https://nexus.tinkar.org/repository/ike-public/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <properties>
        <!-- Main rides the workspace engine snapshot: the retirement round of
             IKE-Network/ike-issues#1124 lands the engine's retirement scope (#1130) and
             this provider's navigation sweep (#1131) together, and the starter set rides
             both until the next train. A release pins the released engine it rides, as
             release 6 rode 1.127.6 (IKE-Network/ike-issues#1123). -->
        <chronology-store.version>1.127.7-SNAPSHOT</chronology-store.version>
        <!-- ike-knowledge-spi 263 ships the change set services (ChangeSetInspector, Verifier,
             Expander, Compactor; IKE-Network/ike-issues#1275) beside the #951 verification contract. -->
        <ike-knowledge-spi.version>263</ike-knowledge-spi.version>
        <!-- The IKE starter set every test of this module reads (IKE-Network/ike-issues#1123):
             its unreasoned export and its bindings, from starter-data-ws, which is built with
             this provider. Both live under the starter-set profile, off by default, so the
             default build needs nothing from starter-data-ws and the provider-to-bindings
             cycle has no hold on a fresh machine (IKE-Network/ike-issues#1260): build this
             module, then starter-data-ws, then `-Pstarter-set` here to compile and run the
             tests. -->
        <ike-starter-set.version>1-SNAPSHOT</ike-starter-set.version>
        <java.version>27</java.version>
        <!-- Lucene 10.5.1 turns its Vector API code on only up to Java 26 and warns on 27.
             The property raises that limit; the full suite passes with it. Drop it when
             a Lucene release supports Java 27. -->
        <argLine>--sun-misc-unsafe-memory-access=allow -Djava.util.logging.manager=org.apache.logging.log4j.jul.LogManager --add-modules jdk.incubator.vector -Dorg.apache.lucene.vectorization.upperJavaFeatureVersion=27</argLine>
        <!-- The nid build check (tinkar-core nid-check, IKE-Network/ike-issues#1244): how it
             reports (error, or warning for a census), which classes may narrow a nid, and
             javac's cap on warnings, high enough that no warning is dropped. -->
        <nid-check.report>error</nid-check.report>
        <nid-check.allow></nid-check.allow>
        <javac.maxwarns>10000</javac.maxwarns>
    </properties>

    <dependencies>
        <!-- The contract this module provides. -->
        <dependency>
            <groupId>network.ike.tooling</groupId>
            <artifactId>ike-knowledge-spi</artifactId>
            <version>${ike-knowledge-spi.version}</version>
        </dependency>

        <!-- Seam-runtime logging binding: the forked seam runs this module on a plain
             classpath, and without a binding tinkar's WARN/ERROR lines (orphan and
             dangling-reference accounting) die in the SLF4J NOP logger instead of
             reaching the [seam] build output (IKE-Network/ike-issues#951).
             log4j2.xml in this jar pins the level to warn. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Engine capability libraries the providers compose. -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>entity</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>common</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>terms</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>

        <!-- Classification: the service contract at compile scope, the reasoner
             implementation at runtime. -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>reasoner-service</artifactId>
            <version>${chronology-store.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>reasoner-elk-snomed</artifactId>
            <version>${chronology-store.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Store providers at runtime scope; their classpath ServiceLoader
             registrations live in this module's META-INF/services (the engine
             providers declare services in module-info only). -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>data-spinedarray-provider</artifactId>
            <version>${chronology-store.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>search-provider</artifactId>
            <version>${chronology-store.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>entity-provider</artifactId>
            <version>${chronology-store.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>executor-provider</artifactId>
            <version>${chronology-store.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
        <!-- The shared test logging configuration (log4j2-test.xml); a library ships none of its own. -->
        <dependency>
            <groupId>dev.ikm.tinkar</groupId>
            <artifactId>test-logging</artifactId>
            <version>${chronology-store.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-jul</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Tests compile and run on the classpath (surefire already does via
                 ike-parent): the module patch would need junit in the module graph,
                 and the classpath is the seam's real runtime anyway. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- This module uses no annotation processor; the inherited
                         RecordBuilder processor path fails on test-source
                         annotations (the known no-compiler-fork limitation). -->
                    <proc>none</proc>
                    <!-- The nid build check (tinkar-core nid-check, IKE-Network/ike-issues#1244). -->
                    <compilerArgs combine.children="append">
                        <arg>-Xplugin:NidCheck report=${nid-check.report} allow=${nid-check.allow}</arg>
                        <arg>-Xmaxwarns</arg>
                        <arg>${javac.maxwarns}</arg>
                        <arg>-Xmaxerrs</arg>
                        <arg>10000</arg>
                    </compilerArgs>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>dev.ikm.tinkar</groupId>
                            <artifactId>nid-check</artifactId>
                            <version>${chronology-store.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                            <useModulePath>false</useModulePath>
                            <!-- Every test source reads the starter set or its bindings: the
                                 starter-set profile compiles them (IKE-Network/ike-issues#1260). -->
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Nothing to run without the profile, and classes left in target from a profile
                 build must not run without it either. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The tests, which read the IKE starter set's unreasoned export and its bindings
             (IKE-Network/ike-issues#1123): on after starter-data-ws is built with this
             provider. Off by default, since the bindings depend back on this module
             (IKE-Network/ike-issues#1260). -->
        <profile>
            <id>starter-set</id>
            <dependencies>
                <!-- The starter set's bindings (IkeTerms) for the components the tests name beyond the kernel. -->
                <dependency>
                    <groupId>network.ike.foundation</groupId>
                    <artifactId>ike-bindings</artifactId>
                    <version>${ike-starter-set.version}</version>
                    <scope>test</scope>
                    <!-- ike-bindings depends back on this module; without the exclusion an installed
                         copy of this module's own jar joins its test path beside target/classes. -->
                    <exclusions>
                        <exclusion>
                            <groupId>network.ike.knowledge</groupId>
                            <artifactId>ike-knowledge-provider</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- The base knowledge file the tests load into an ephemeral store. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-base-knowledge</id>
                                <phase>process-test-resources</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>network.ike.foundation</groupId>
                                            <artifactId>ike-starter-set</artifactId>
                                            <version>${ike-starter-set.version}</version>
                                            <classifier>unreasoned-pb</classifier>
                                            <type>zip</type>
                                            <overWrite>false</overWrite>
                                            <outputDirectory>${project.build.directory}/data</outputDirectory>
                                            <destFileName>ike-starter-set-unreasoned-pb.zip</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-testCompile</id>
                                <configuration>
                                    <skip>false</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
